# Clyro - College Club Activities Tracker
# Environment Configuration Template

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Workspace Institutional SSO
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_WORKSPACE_DOMAIN=mirai.edu
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=mirai.edu

# Session & Token Cryptographic Secret (HMAC-SHA256)
AUTH_SECRET=clyro-mirai-session-secret-2024-msot

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Bucket
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=club-submissions

# Optional: Demo Mode (true enables in-memory mock backend if Supabase is unconfigured)
NEXT_PUBLIC_DEMO_MODE=true
